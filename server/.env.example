ANTHROPIC_API_KEY=
PORT=3001

# Hard ceiling on model spend per UTC day, enforced in server/spend.js before
# every paid API call — not just reported afterward. Defaults to 5 (USD) when
# blank. When the day's spend reaches it, agent runs stop with a plain error
# until the day rolls over or you raise this.
DAILY_SPEND_CAP_USD=

# Set to "true" to make this server incapable of any real-world action
# (deploys, customer email) no matter what any venture's own scope says —
# the strongest form of the kill switch in server/killSwitch.js, and the only
# one the app itself cannot lift. The Ventures panel has a runtime halt for
# everything short of that.
REAL_ACTIONS_DISABLED=

# Set to "true" to disable the autonomous daily meeting cycle (see
# server/scheduler.js) if you'd rather trigger it manually every time.
DAILY_MEETING_DISABLED=

# Set to "true" to disable the autonomous weekly reflection cycle (see
# server/weeklyScheduler.js) if you'd rather trigger it manually every time.
WEEKLY_REFLECTION_DISABLED=

# Optional: email the Daily Report and the Weekly Reflection (see
# server/email.js) once each is generated. Leave SMTP_HOST and
# REPORT_EMAIL_TO blank to skip email entirely — both are always still
# viewable in the Daily Report tab either way.
# The same SMTP config also powers real customer outreach (see the "Real
# customer email" section of ORG_STRUCTURE.md): once a venture's outreach
# scope is set up and enabled from the Ventures panel, the Sales &
# Commercial Manager can send real emails to real recipients using this
# same transport. There's no separate setting for that — leaving SMTP_HOST
# blank keeps outreach unavailable the same way it keeps the daily report
# email unavailable.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your address,
# SMTP_PASS=an app password (not your normal password) from
# https://myaccount.google.com/apppasswords. Any other SMTP provider works
# the same way.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
REPORT_EMAIL_FROM=
REPORT_EMAIL_TO=

# Optional: lets the Engineering Lead make real, live commits to a venture's
# repo (see server/deploy/github.js and the "Real code deployment" section
# of ORG_STRUCTURE.md) once the founder links that repo and enables it from
# the Ventures panel. Leave blank to keep this app fully simulated — every
# other feature works without it. A fine-grained personal access token
# scoped only to the specific repo(s) you intend to link, with just
# "Contents: Read and write" permission, is the safest way to set this.
GITHUB_TOKEN=

# Optional: run the leaf specialist agents on a cheaper model (Nous Research's
# Hermes 4 70B via OpenRouter) instead of Claude, to cut the company's one
# real recurring cost. See "Mixed-model routing" in ORG_STRUCTURE.md.
# Leave blank and every agent runs on Claude exactly as before — this changes
# nothing else about how the company works. Only agents with no reports, no
# action tools and no web search are ever routed here; that rule is enforced
# in server/agents/models.js, not left to the agent definitions.
# Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# Optional: long-term memory about *you* via Honcho (honcho.dev), so the
# teams build up a picture of how the founder actually thinks across every
# conversation rather than starting cold each session. See "Memory about the
# founder" in ORG_STRUCTURE.md.
# Leave blank and nothing calls out — the app keeps its own file-backed
# memory about the business either way. Honcho is never a source of truth
# here: ventures, the ledger and the outreach log stay in server/data/.
# Get a key at https://app.honcho.dev (a new account comes with free credits).
HONCHO_API_KEY=
# Optional: separate the memory a staging instance builds from production's.
# Defaults to "jarvis".
HONCHO_WORKSPACE_ID=

# Share of net profit distributed among the agents who did the work, as a
# percentage (see "Every agent earns a share" in ORG_STRUCTURE.md). Defaults
# to 10 when blank. Set to 0 to turn the share off entirely — agents are then
# told they have earned nothing, which is true.
# Capped at 20 in code: that ceiling applies to the whole pool shared between
# all the agents, not to any one of them, so at most a fifth of net profit
# ever leaves the company however this is set. A higher value is clamped
# rather than rejected.
# The pool is a share of NET profit, so nothing is owed while the company is
# unprofitable; contributions are still tracked and distribute the moment it
# turns positive.
AGENT_PROFIT_SHARE_PCT=

# Optional: publish the company's written output into a GitHub repo you open
# as an Obsidian vault and/or in VS Code (see "The company works in your
# tools" in ORG_STRUCTURE.md). Daily reports, weekly reflections and one note
# per venture are committed as markdown with Obsidian frontmatter and
# [[wikilinks]]. Needs GITHUB_TOKEN above, with write access to this repo.
# Leave blank and nothing is written — every other feature works without it.
# Sync the repo into Obsidian with a git plugin (SyncGit, Obsidian Git, or
# Vault Sync); VS Code opens it as a folder with no plugin at all.
WORKSPACE_REPO_OWNER=
WORKSPACE_REPO_NAME=
# Defaults to "main" when blank.
WORKSPACE_REPO_BRANCH=

# Optional: talk to the Executive Team from WhatsApp (see "Talking to the
# company from WhatsApp" in ORG_STRUCTURE.md). Leave blank and the webhook
# refuses everything — every other feature works without it.
#
# From the Meta app dashboard (developers.facebook.com -> your app ->
# WhatsApp): WHATSAPP_TOKEN is the access token, WHATSAPP_PHONE_NUMBER_ID is
# the sending number's id, and WHATSAPP_APP_SECRET is under App Settings ->
# Basic. WHATSAPP_VERIFY_TOKEN is a string you invent and paste into the
# webhook setup form so Meta can prove it's reaching the right server.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# REQUIRED for WhatsApp to work at all, and the most important line here.
# Comma-separated numbers allowed to message the company. A valid Meta
# signature only proves Meta sent the message, not who typed it — anyone who
# finds the number can write to it, and what's behind it can commit code and
# email customers. Empty means nobody gets in, which is the safe default.
# Formatting is ignored, so "+44 7700 900123" and "447700900123" both work.
WHATSAPP_ALLOWED_NUMBERS=

# Optional: OpenAI, which does three separate jobs here. Set the key and all
# three switch on; leave it blank and nothing else changes.
#
#   1. Voice notes. Without this a voice note on WhatsApp gets an apology;
#      with it, the note is transcribed and reaches the team as text.
#   2. A fallback when Anthropic can't answer — out of credit, key rejected,
#      or an outage. The company answers on OpenAI instead of going silent.
#      An agent that normally delegates says so in the reply, because a lone
#      model is not the same thing as the departments weighing in.
#   3. A model tier ('assistant') that leaf agents can run on, the same way
#      they can run on Hermes via OpenRouter.
OPENAI_API_KEY=
# Model names are pinned by hand like every price in this app, but these are
# also overridable because OpenAI retires and renames models faster than this
# file gets edited — a stale default should be a one-variable fix here rather
# than a redeploy. Defaults: gpt-4o-mini, gpt-4o, whisper-1. The Integrations
# panel checks these names against what your key can actually see.
OPENAI_MODEL=
OPENAI_FALLBACK_MODEL=
OPENAI_TRANSCRIBE_MODEL=
# Per million tokens, for the daily spend cap. A wrong price silently
# mis-meters the company's only real recurring cost, so it's settable without
# a code change. Defaults: 0.15 in / 0.6 out.
OPENAI_INPUT_PRICE_PER_MTOK=
OPENAI_OUTPUT_PRICE_PER_MTOK=

# Optional: how much room an agent gets to answer in (output tokens).
# Defaults to 4096. The old 1024 was too small for a synthesis across
# departments and produced a truncated turn with no text at all, which read
# as the team being unable to answer. Raise it if answers still stop short.
AGENT_MAX_TOKENS=

# Optional: a contact address shown on the public /privacy page. Left blank,
# the page says the app is privately operated instead — publishing a personal
# email is a decision, not a default.
PRIVACY_CONTACT_EMAIL=

# Optional: Gemini, as a second backup. If Anthropic can't answer the chain
# is OpenAI first, then Gemini — two backups rather than one, because a
# single backup is still a single point of failure and the point of this
# path is that the company keeps answering. Leaf agents can also run on the
# 'analyst' tier, same leaf-only rule as the others.
GEMINI_API_KEY=
# Overridable for the same reason as the OpenAI names: Google renames and
# retires models faster than this file gets edited. Default:
# gemini-2.0-flash. The Integrations panel checks the name against what your
# key can actually see.
GEMINI_MODEL=
# Per million tokens, for the daily spend cap. Defaults: 0.1 in / 0.4 out.
GEMINI_INPUT_PRICE_PER_MTOK=
GEMINI_OUTPUT_PRICE_PER_MTOK=

# Optional: how often to poll a running GitHub Actions run, in ms. Default
# 5000. Only worth changing for tests, which stub the API and have nothing
# to wait for.
EXECUTION_POLL_MS=

# Optional: which model OpenRouter serves when it is standing in for a failed
# Anthropic call, rather than running a leaf agent on the cheap tier.
# Defaults to the cheap-tier model. Set this to an Anthropic model offered on
# OpenRouter (e.g. anthropic/claude-sonnet-5) and it becomes the truest
# substitute in the backup chain: the same model, billed through a different
# account — which is exactly the failure that took this company down.
OPENROUTER_FALLBACK_MODEL=

# Optional: which model OpenRouter serves when it is standing in for a failed
# Anthropic call, rather than running a leaf agent on the cheap tier.
# Defaults to the cheap-tier model. Set this to an Anthropic model offered on
# OpenRouter (e.g. anthropic/claude-sonnet-5) and it becomes the truest
# substitute in the backup chain: the same model, billed through a different
# account — which is exactly the failure that took this company down.
OPENROUTER_FALLBACK_MODEL=

# Optional: hand repo linking and deployment to the CEO and CTO instead of
# doing it yourself. Comma-separated owner/name. Inside this set they link,
# enable and ship without asking; outside it, nothing gets through — and no
# amount of agent reasoning gets past that check, because it is enforced in
# the data layer rather than a prompt.
#
# Empty or unset keeps today's behaviour: the founder links repos and enables
# deployment. Autonomy is something you turn on deliberately, not something
# that arrives with an upgrade.
#
# Note what this does and does not delegate. The team chooses which paths it
# may write, so the path allowlist stops being a limit you set — what still
# binds is this repo list, the per-day and per-week commit caps, the cooldown,
# the kill switch, and the fact that every link and commit is logged.
AUTONOMOUS_DEPLOY_REPOS=

# Optional: require the team to submit a daily plan the founder approves
# before any real action runs. "true" to force it on, "false" to force it
# off. Left blank it follows AUTONOMOUS_DEPLOY_REPOS — handing the team
# self-service deployment without a plan to approve would be autonomy with
# nothing bounding it.
#
# The plan is pushed to WhatsApp when submitted; replying APPROVE or
# REJECT <reason> decides it. That reply is parsed by the server before the
# company turn ever sees it — an agent that interprets "approve" is an agent
# that can conclude it was approved.
DAILY_PLAN_REQUIRED=

# Optional: how much conversation each session carries. Defaults: 120
# messages (user and assistant combined) and 80,000 characters, whichever
# binds first. Both are read per request, so they can be tuned from the
# dashboard without a redeploy.
#
# This was 20 messages, which is ten exchanges — fine for a web chat opened
# to ask one thing, and badly wrong for WhatsApp, where a conversation passes
# ten exchanges before lunch. History is re-sent on every turn, so raising
# these costs input tokens.
SESSION_MAX_MESSAGES=
SESSION_MAX_CHARS=

# Strongly recommended: lock the API behind a shared secret. Without it,
# anyone with this app's URL can halt or resume real actions, grant a venture
# deployment scope, read your WhatsApp log and spend the model budget — the
# scope model rests on a founder the system otherwise has no way to identify.
#
# A single secret rather than accounts, because there is one user; inventing a
# user table would be pretending otherwise. Generate something long and random
# (`openssl rand -hex 32`). The browser asks for it once and remembers it.
#
# Three paths stay public by necessity: /api/health (Railway's healthcheck —
# locking it restarts the service in a loop), /api/whatsapp/webhook (Meta
# cannot send a bearer token, and signs an HMAC instead, which is stronger),
# and /privacy (Meta fetches it, and a privacy policy behind a password is not
# a privacy policy).
#
# Left unset the API stays open and says so loudly — at boot and in red in the
# Integrations panel. Failing closed would lock you out of your own running
# app on the next deploy, from a phone, with no way to set a header.
APP_ACCESS_TOKEN=

# Optional: how much room a leaf specialist gets to answer in. Default 2000.
# Sixteen of the twenty-one agents are leaves, so their generation dominates
# how long a real question takes — this is the biggest latency lever here. A
# cap doesn't force brevity, it removes the room to ramble. Raise it if
# specialist answers start stopping mid-sentence; lower it for speed.
AGENT_MAX_LEAF_TOKENS=

# Optional: a turn slower than this gets a log line naming the three agents
# that took the longest. Default 45000 (45s).
SLOW_TURN_MS=

# Optional: how hard each kind of agent thinks. Defaults: leaves "low",
# orchestrators "high". Valid: low, medium, high, xhigh, max.
#
# A better lever than a token cap — it reduces how much a specialist
# deliberates rather than truncating what it writes. Sixteen of the
# twenty-one agents are leaves answering bounded questions; orchestrators
# decide what the company does, which is where thinking earns its cost.
AGENT_LEAF_EFFORT=
AGENT_ORCHESTRATOR_EFFORT=

# Optional: where agent skills live. Defaults to server/skills/library.
# A skill is a markdown file with name/description frontmatter; agents see the
# descriptions and load a body only when the work calls for it. See
# server/skills/README.md.
SKILLS_DIR=
