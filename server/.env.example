ANTHROPIC_API_KEY=
PORT=3001

# Hard ceiling on model spend per UTC day, enforced in server/spend.js before
# every paid API call — not just reported afterward. Defaults to 5 (USD) when
# blank. When the day's spend reaches it, agent runs stop with a plain error
# until the day rolls over or you raise this.
DAILY_SPEND_CAP_USD=

# Set to "true" to make this server incapable of any real-world action
# (deploys, customer email) no matter what any venture's own scope says —
# the strongest form of the kill switch in server/killSwitch.js, and the only
# one the app itself cannot lift. The Ventures panel has a runtime halt for
# everything short of that.
REAL_ACTIONS_DISABLED=

# Set to "true" to disable the autonomous daily meeting cycle (see
# server/scheduler.js) if you'd rather trigger it manually every time.
DAILY_MEETING_DISABLED=

# Set to "true" to disable the autonomous weekly reflection cycle (see
# server/weeklyScheduler.js) if you'd rather trigger it manually every time.
WEEKLY_REFLECTION_DISABLED=

# Optional: email the Daily Report and the Weekly Reflection (see
# server/email.js) once each is generated. Leave SMTP_HOST and
# REPORT_EMAIL_TO blank to skip email entirely — both are always still
# viewable in the Daily Report tab either way.
# The same SMTP config also powers real customer outreach (see the "Real
# customer email" section of ORG_STRUCTURE.md): once a venture's outreach
# scope is set up and enabled from the Ventures panel, the Sales &
# Commercial Manager can send real emails to real recipients using this
# same transport. There's no separate setting for that — leaving SMTP_HOST
# blank keeps outreach unavailable the same way it keeps the daily report
# email unavailable.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your address,
# SMTP_PASS=an app password (not your normal password) from
# https://myaccount.google.com/apppasswords. Any other SMTP provider works
# the same way.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
REPORT_EMAIL_FROM=
REPORT_EMAIL_TO=

# Optional: lets the Engineering Lead make real, live commits to a venture's
# repo (see server/deploy/github.js and the "Real code deployment" section
# of ORG_STRUCTURE.md) once the founder links that repo and enables it from
# the Ventures panel. Leave blank to keep this app fully simulated — every
# other feature works without it. A fine-grained personal access token
# scoped only to the specific repo(s) you intend to link, with just
# "Contents: Read and write" permission, is the safest way to set this.
GITHUB_TOKEN=

# Optional: run the leaf specialist agents on a cheaper model (Nous Research's
# Hermes 4 70B via OpenRouter) instead of Claude, to cut the company's one
# real recurring cost. See "Mixed-model routing" in ORG_STRUCTURE.md.
# Leave blank and every agent runs on Claude exactly as before — this changes
# nothing else about how the company works. Only agents with no reports, no
# action tools and no web search are ever routed here; that rule is enforced
# in server/agents/models.js, not left to the agent definitions.
# Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# Optional: long-term memory about *you* via Honcho (honcho.dev), so the
# teams build up a picture of how the founder actually thinks across every
# conversation rather than starting cold each session. See "Memory about the
# founder" in ORG_STRUCTURE.md.
# Leave blank and nothing calls out — the app keeps its own file-backed
# memory about the business either way. Honcho is never a source of truth
# here: ventures, the ledger and the outreach log stay in server/data/.
# Get a key at https://app.honcho.dev (a new account comes with free credits).
HONCHO_API_KEY=
# Optional: separate the memory a staging instance builds from production's.
# Defaults to "jarvis".
HONCHO_WORKSPACE_ID=

# Share of net profit distributed among the agents who did the work, as a
# percentage (see "Every agent earns a share" in ORG_STRUCTURE.md). Defaults
# to 10 when blank. Set to 0 to turn the share off entirely — agents are then
# told they have earned nothing, which is true.
# Capped at 20 in code: that ceiling applies to the whole pool shared between
# all the agents, not to any one of them, so at most a fifth of net profit
# ever leaves the company however this is set. A higher value is clamped
# rather than rejected.
# The pool is a share of NET profit, so nothing is owed while the company is
# unprofitable; contributions are still tracked and distribute the moment it
# turns positive.
AGENT_PROFIT_SHARE_PCT=

# Optional: publish the company's written output into a GitHub repo you open
# as an Obsidian vault and/or in VS Code (see "The company works in your
# tools" in ORG_STRUCTURE.md). Daily reports, weekly reflections and one note
# per venture are committed as markdown with Obsidian frontmatter and
# [[wikilinks]]. Needs GITHUB_TOKEN above, with write access to this repo.
# Leave blank and nothing is written — every other feature works without it.
# Sync the repo into Obsidian with a git plugin (SyncGit, Obsidian Git, or
# Vault Sync); VS Code opens it as a folder with no plugin at all.
WORKSPACE_REPO_OWNER=
WORKSPACE_REPO_NAME=
# Defaults to "main" when blank.
WORKSPACE_REPO_BRANCH=

# Optional: talk to the Executive Team from WhatsApp (see "Talking to the
# company from WhatsApp" in ORG_STRUCTURE.md). Leave blank and the webhook
# refuses everything — every other feature works without it.
#
# From the Meta app dashboard (developers.facebook.com -> your app ->
# WhatsApp): WHATSAPP_TOKEN is the access token, WHATSAPP_PHONE_NUMBER_ID is
# the sending number's id, and WHATSAPP_APP_SECRET is under App Settings ->
# Basic. WHATSAPP_VERIFY_TOKEN is a string you invent and paste into the
# webhook setup form so Meta can prove it's reaching the right server.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# REQUIRED for WhatsApp to work at all, and the most important line here.
# Comma-separated numbers allowed to message the company. A valid Meta
# signature only proves Meta sent the message, not who typed it — anyone who
# finds the number can write to it, and what's behind it can commit code and
# email customers. Empty means nobody gets in, which is the safe default.
# Formatting is ignored, so "+44 7700 900123" and "447700900123" both work.
WHATSAPP_ALLOWED_NUMBERS=
