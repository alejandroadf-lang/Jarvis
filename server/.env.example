ANTHROPIC_API_KEY=
PORT=3001

# Set to "true" to disable the autonomous daily meeting cycle (see
# server/scheduler.js) if you'd rather trigger it manually every time.
DAILY_MEETING_DISABLED=

# Optional: email the Daily Report (see server/email.js) once it's generated
# each day. Leave SMTP_HOST and REPORT_EMAIL_TO blank to skip email entirely
# — the report is always still viewable in the Daily Report tab either way.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your address,
# SMTP_PASS=an app password (not your normal password) from
# https://myaccount.google.com/apppasswords. Any other SMTP provider works
# the same way.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
REPORT_EMAIL_FROM=
REPORT_EMAIL_TO=
